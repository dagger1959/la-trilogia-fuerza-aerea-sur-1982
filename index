<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Testimonio de una Trilogía — II Escuadrón Aeromóvil de Guerra M-5 IAI Dagger</title>

  <!-- Vincular el archivo manifest para instalar como App (PWA) -->
  <link rel="manifest" href="manifest.json">

  <!-- Fuentes tipográficas académicas -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

  <!-- Librería para generar código QR dinámico y descargable -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    :root {
      --bg-color: #111317;
      --card-bg: #181b22;
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --accent-gold: #c5a059;
      --border-color: #2a2f3a;
      --shadow-color: rgba(0, 0, 0, 0.6);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'EB Garamond', Georgia, serif;
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .toolbar {
      width: 100%;
      max-width: 920px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 22px;
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      margin-bottom: 25px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .toolbar h1 {
      font-family: 'Cinzel', serif;
      font-size: 1.05rem;
      letter-spacing: 1.5px;
      color: var(--accent-gold);
      text-transform: uppercase;
    }

    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      background-color: transparent;
      color: var(--text-main);
      border: 1px solid var(--accent-gold);
      padding: 8px 16px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    .btn:hover {
      background-color: var(--accent-gold);
      color: #111317;
    }

    .sheet-container {
      width: 100%;
      max-width: 920px;
      background-color: #16181f;
      border: 1px solid var(--border-color);
      box-shadow: 0 12px 35px var(--shadow-color);
      padding: 45px;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .sheet-header {
      text-align: center;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 22px;
    }

    .sheet-header .subtitle {
      font-family: 'Inter', sans-serif;
      font-size: 0.8rem;
      letter-spacing: 3px;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .sheet-header h2 {
      font-family: 'Cinzel', serif;
      font-size: 1.75rem;
      color: var(--accent-gold);
      margin: 8px 0 4px 0;
      font-weight: 700;
    }

    .sheet-header .trilogy-title {
      font-family: 'Cinzel', serif;
      font-size: 1.1rem;
      color: var(--text-main);
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .sheet-header .location {
      font-family: 'Inter', sans-serif;
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 300;
    }

    /* GALERÍA DE IMÁGENES TESTIMONIALES */
    .gallery-section {
      display: flex;
      flex-direction: column;
      gap: 15px;
      align-items: center;
    }

    .gallery-nav {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .tab-btn {
      background-color: #111317;
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      padding: 8px 16px;
      font-family: 'Inter', sans-serif;
      font-size: 0.8rem;
      cursor: pointer;
      border-radius: 3px;
      transition: all 0.2s ease;
    }

    .tab-btn.active, .tab-btn:hover {
      border-color: var(--accent-gold);
      color: var(--accent-gold);
      background-color: rgba(197, 160, 89, 0.08);
    }

    .image-container {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      background-color: #0b0c0f;
      border: 1px solid #222630;
      border-radius: 4px;
      padding: 20px;
    }

    .image-container img {
      max-width: 100%;
      max-height: 480px;
      object-fit: contain;
      border-radius: 2px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.7);
      cursor: zoom-in;
    }

    .image-caption {
      margin-top: 14px;
      font-family: 'Inter', sans-serif;
      font-size: 0.82rem;
      color: var(--text-muted);
      text-align: center;
    }

    /* FICHA TÉCNICA DOCUMENTAL Y SECCIÓN QR */
    .archive-card {
      border: 1px solid var(--border-color);
      background-color: rgba(255, 255, 255, 0.015);
      padding: 28px;
      border-radius: 4px;
    }

    .archive-card h3 {
      font-family: 'Cinzel', serif;
      font-size: 1.15rem;
      color: var(--accent-gold);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 10px;
      margin-bottom: 22px;
      letter-spacing: 1px;
    }

    .trilogy-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px dashed var(--border-color);
    }

    .trilogy-box {
      background-color: rgba(0, 0, 0, 0.25);
      border: 1px solid var(--border-color);
      border-left: 3px solid var(--accent-gold);
      padding: 14px 16px;
      border-radius: 2px;
    }

    .trilogy-box .pillar-number {
      font-family: 'Inter', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent-gold);
      margin-bottom: 4px;
    }

    .trilogy-box h4 {
      font-family: 'Cinzel', serif;
      font-size: 1rem;
      color: var(--text-main);
      margin-bottom: 6px;
    }

    .trilogy-box p {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
    }

    .meta-label {
      font-family: 'Inter', sans-serif;
      font-size: 0.73rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .meta-value {
      font-size: 1.05rem;
      color: var(--text-main);
    }

    .meta-value.highlight {
      color: var(--accent-gold);
      font-weight: 600;
    }

    /* SECCIÓN CÓDIGO QR PARA DIFUSIÓN */
    .qr-section {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      background-color: rgba(0, 0, 0, 0.2);
      padding: 20px;
      border-radius: 6px;
    }

    .qr-wrapper {
      background-color: #ffffff;
      padding: 12px;
      border-radius: 6px;
      border: 2px solid var(--accent-gold);
      display: inline-block;
    }

    .qr-caption {
      font-family: 'Inter', sans-serif;
      font-size: 0.8rem;
      color: var(--text-muted);
      text-align: center;
    }

    /* FORMULARIO DE COMENTARIOS */
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-family: 'Inter', sans-serif;
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-control {
      background-color: #0d0f14;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 10px 12px;
      border-radius: 4px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-control:focus {
      border-color: var(--accent-gold);
    }

    .sheet-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--border-color);
      padding-top: 16px;
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 12px;
    }

    .visitor-counter {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(0, 0, 0, 0.92);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .modal img {
      max-width: 95%;
      max-height: 95vh;
      object-fit: contain;
    }

    @media (max-width: 768px) {
      .trilogy-grid { grid-template-columns: 1fr; }
      .sheet-container { padding: 20px; }
      .sheet-footer { flex-direction: column; text-align: center; }
    }

    @media print {
      body { background-color: #ffffff !important; color: #000000 !important; padding: 0; }
      .toolbar, .gallery-nav, .contact-card, .visitor-counter, .download-qr-btn { display: none !important; }
      .sheet-container { border: none !important; box-shadow: none !important; background-color: #ffffff !important; color: #000000 !important; padding: 0 !important; max-width: 100% !important; }
      .sheet-header h2, .archive-card h3, .trilogy-box .pillar-number, .meta-value.highlight { color: #111111 !important; }
      .trilogy-box { background-color: #f8f9fa !important; border: 1px solid #cccccc !important; border-left: 3px solid #111111 !important; }
      .trilogy-box h4, .meta-value { color: #222222 !important; }
      .sheet-header .subtitle, .sheet-header .location, .meta-label, .image-caption, .sheet-footer { color: #555555 !important; }
      .archive-card, .image-container { border: 1px solid #cccccc !important; background-color: #ffffff !important; }
      .image-container img { box-shadow: none !important; }
    }
  </style>
</head>
<body>

