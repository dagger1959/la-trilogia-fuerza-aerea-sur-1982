  <script>
    // Generación del Código QR en pantalla al cargar la página
    window.addEventListener('DOMContentLoaded', function() {
      new QRCode(document.getElementById("qrcode"), {
        text: window.location.href,
        width: 160,
        height: 160,
        colorDark : "#000000",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.H
      });
    });

    // Función para descargar la imagen del QR directamente a la computadora
    function downloadQR() {
      const qrImg = document.querySelector("#qrcode img");
      const qrCanvas = document.querySelector("#qrcode canvas");
      
      let imageURI = "";
      if (qrImg && qrImg.src) {
        imageURI = qrImg.src;
      } else if (qrCanvas) {
        imageURI = qrCanvas.toDataURL("image/png");
      }

      if (imageURI) {
        const link = document.createElement("a");
        link.href = imageURI;
        link.download = "QR_Testimonio_Trilogia_Malvinas.png";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } else {
        alert("El código QR se está generando, reintente en unos segundos.");
      }
    }

    function changeImage(element, src, caption) {
      const img = document.getElementById('main-image');
      const cap = document.getElementById('image-caption');
      img.src = src;
      cap.innerText = caption;

      const buttons = document.querySelectorAll('.tab-btn');
      buttons.forEach(btn => btn.classList.remove('active'));
      element.classList.add('active');
    }

    function handleImageError(img) {
      img.src = 'https://images.unsplash.com/photo-1519074069444-1ba4effa69b6?q=80&w=800&auto=format&fit=crop';
    }

    function openModal() {
      const img = document.getElementById('main-image');
      const modal = document.getElementById('image-modal');
      const modalImg = document.getElementById('modal-img');
      modal.style.display = 'flex';
      modalImg.src = img.src;
    }

    function closeModal() {
      document.getElementById('image-modal').style.display = 'none';
    }
  </script>
</body>
</html>
